{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|favicon.svg|icons.svg|manifest.webmanifest|registerSW.js|sw.js|workbox-.*).*)",
      "destination": "/index.html"
    }
  ]
}
